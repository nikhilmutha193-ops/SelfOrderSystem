# Production settings for docker-compose.prod.yml.
# Copy this file to ".env" on the Docker server (same folder as docker-compose.prod.yml) and fill it in.
# Never commit the real .env: it holds secrets.

# ---- Required ----------------------------------------------------------------------------------

# A long random string. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later signs everyone out and makes printed table QR codes stop working.
JWT_SECRET=

# The key of your restaurant in the database. Any short word; it must match the seeded restaurant.
RESTAURANT_KEY=resto_main

# Your site's address, exactly as people type it, for example https://order.example.com
# Comma separate several. Use http://<server-ip> if you have no domain yet.
CLIENT_ORIGIN=

# ---- Common ------------------------------------------------------------------------------------

# How long a staff login lasts before it must be renewed.
JWT_EXPIRES_IN=8h

# Host ports for the web server. 80 and 443 are the usual ones on a server.
HTTP_PORT=80
HTTPS_PORT=443

# Names added to the built-in self-signed certificate, for example DNS:order.example.com or IP:203.0.113.10.
# Not needed with docker-compose.https.yml (Caddy gets a real certificate).
TLS_EXTRA_SAN=

# Number of reverse proxies in front of the API: 1 normally, 2 with docker-compose.https.yml.
TRUST_PROXY_HOPS=1

# ---- Trusted HTTPS on a real domain (docker-compose.https.yml) ---------------------------------

# DOMAIN=order.example.com

# ---- Images from a registry (optional) ---------------------------------------------------------
# Build once on your own machine, push, and only pull on the server:
#   IMAGE_REGISTRY=ghcr.io/your-name/selforder   IMAGE_TAG=1.0.0
# Left unset, the server builds the images itself from this folder.
# IMAGE_REGISTRY=selforder
# IMAGE_TAG=latest

# ---- Database ----------------------------------------------------------------------------------
# Keep the database in a folder on the server instead of a Docker volume (safer against `docker volume prune`).
# The folder must exist and be owned by user 999 (see docs/DEPLOY.md, "Keeping the data safe").
# MONGO_DATA_DIR=/opt/selforder-data/mongo
# MongoDB 5+ needs a CPU with AVX. If the mongo container keeps restarting on your VPS (check:  grep -c avx /proc/cpuinfo  prints 0),
# use the last version that does not need it:
# MONGO_IMAGE=mongo:4.4
# Left unset, the bundled MongoDB container is used (data in the mongo_data volume).
# For MongoDB Atlas or another server (it must be a replica set):
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/selforder

# ---- Optional services -------------------------------------------------------------------------

# Cloudflare R2 for images and private files. Without these, files stay in Docker volumes.
# Files are grouped under a folder named after RESTAURANT_KEY: <RESTAURANT_KEY>/Banner, /Logo, /Product Image, /Team, /Awards
# in R2_BUCKET, and /Invoices, /Backups, /PaymentProofs in R2_PRIVATE_BUCKET. The folders are created automatically on start.
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
# R2_PRIVATE_BUCKET=

# Texts guests when a booking is confirmed or cancelled. Leave empty for no SMS.
# FAST2SMS_API_KEY=

# Redirect addresses the OAuth flow may use (comma separated, exact match).
# OAUTH_ALLOWED_REDIRECT_URIS=
