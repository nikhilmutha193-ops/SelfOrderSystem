{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kill dev ports",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/kill-dev-ports.ps1"
      ],
      "presentation": {
        "group": "fullstack",
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "prelaunch: server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/prelaunch-server.ps1"
      ],
      "presentation": {
        "group": "fullstack",
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "server: dev",
      "type": "npm",
      "script": "dev",
      "path": "server",
      "isBackground": true,
      "problemMatcher": {
        "owner": "selforder-server",
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+error\\s+(TS\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "listening|running|started"
        }
      },
      "presentation": {
        "group": "fullstack",
        "reveal": "always"
      }
    },
    {
      "label": "client: dev",
      "type": "npm",
      "script": "dev",
      "path": "client",
      "isBackground": true,
      "problemMatcher": {
        "owner": "selforder-client",
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+error\\s+(TS\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "ready in|Local:"
        }
      },
      "presentation": {
        "group": "fullstack",
        "reveal": "always"
      }
    }
  ]
}
