PORT=5000
# For `npm run dev` against the mongo container from docker-compose.yml (run `docker compose up
# -d mongo` to start just that service): directConnection skips replica-set topology discovery,
# which would otherwise try to reach the container by its internal Docker hostname ("mongo").
MONGO_URI=mongodb://127.0.0.1:27017/selforder?replicaSet=rs0&directConnection=true
# Or an external MongoDB (e.g. Atlas):
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/selforder?appName=yourApp
RESTAURANT_KEY=resto_demo
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated exact-match allow-list of redirect URIs an OAuth client (e.g. an MCP host)
# is permitted to use with /api/oauth/authorize. Required for the OAuth flow to work at all -
# a request with an unlisted redirect_uri is rejected rather than silently allowed.
OAUTH_ALLOWED_REDIRECT_URIS=https://your-production-domain.com/api/oauth/callback

# Optional - Fast2SMS API key (https://www.fast2sms.com), used to text guests when a table
# booking is confirmed or cancelled/no-show. Leave empty to skip sending SMS entirely.
FAST2SMS_API_KEY=
