# Copy this file to ".env" in the repo root (same folder as docker-compose.yml)
# and fill in real values before running `docker compose up`.
# This file is committed - never put real credentials in it.

# Optional - connection string for an external MongoDB (e.g. Atlas). Leave unset/commented out
# and docker-compose.yml's default is used instead: the bundled `mongo` container, a
# single-node replica set with its data in the mongo_data volume. Set this to point at your
# own MongoDB (Atlas or otherwise) instead.
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/selforder?appName=yourApp

# Required - any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Tenant key for this deployment's restaurant (must match a seeded restaurant).
RESTAURANT_KEY=resto_demo

# How long an issued login token stays valid.
JWT_EXPIRES_IN=8h

# Host port the UI is published on (http://localhost:<this>).
CLIENT_PORT=8080

# ---- HTTPS for local/LAN testing (camera access needs it) ----
# Browsers only expose the camera (for the in-page QR scanner) on a "secure context" - HTTPS,
# or the special case of localhost. A real deployment with a real domain (e.g. Vercel) gets a
# trusted certificate automatically; testing over your LAN (e.g. opening the site from a phone
# at http://192.168.x.x:8080) does not, so the client container generates a self-signed one
# instead. Browsers will show a one-time certificate warning to accept per device.
#
# Host port the self-signed HTTPS site is published on (https://<your-lan-ip>:<this>).
CLIENT_TLS_PORT=8443
# Your LAN IP (or hostname), so the certificate is valid for it too - find it with `ipconfig`
# (Windows) or `ifconfig`/`ip addr` (macOS/Linux). Leave empty to only cover localhost/127.0.0.1.
TLS_EXTRA_SAN=IP:192.168.1.20

# Allowed browser origin(s) for the API, comma-separated (e.g. https://order.yoursite.com).
# In the bundled setup the UI reaches the API same-origin through nginx, so "*" is harmless;
# set this to your real origin if you ever expose the API directly to browsers.
CLIENT_ORIGIN=*

# ---- Image storage (Cloudflare R2) ----
# Optional locally: leave R2_BUCKET empty and uploads are written to the local
# uploads/ volume instead. Required on serverless hosts (Vercel), whose
# filesystem is read-only. Set all four together.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for the bucket - the r2.dev development URL or your custom
# domain. Uploaded images are served from here, so the bucket needs public read.
R2_PUBLIC_BASE_URL=

# Separate bucket WITHOUT public access, for invoice PDFs and database backups.
# The public URL above exposes every object in R2_BUCKET, so tenant data must not
# live there. Left empty, invoices and backups stay on local disk.
R2_PRIVATE_BUCKET=

# Optional - Fast2SMS API key (https://www.fast2sms.com), used to text guests when a table
# booking is confirmed or cancelled/no-show. Leave empty to skip sending SMS entirely.
FAST2SMS_API_KEY=
