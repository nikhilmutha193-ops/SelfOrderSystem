# Copy this file to ".env" in the repo root (same folder as docker-compose.yml)
# and fill in real values before running `docker compose up`.
# This file is committed - never put real credentials in it.

# Required - connection string for an external MongoDB (e.g. Atlas). This deployment expects
# a database you manage yourself; there is no bundled local Mongo container.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/selforder?appName=yourApp

# Required - any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Tenant key for this deployment's restaurant (must match a seeded restaurant).
RESTAURANT_KEY=resto_demo

# How long an issued login token stays valid.
JWT_EXPIRES_IN=8h

# Host port the UI is published on (http://localhost:<this>).
CLIENT_PORT=8080

# ---- Image storage (Cloudflare R2) ----
# Optional locally: leave R2_BUCKET empty and uploads are written to the local
# uploads/ volume instead. Required on serverless hosts (Vercel), whose
# filesystem is read-only. Set all four together.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for the bucket - the r2.dev development URL or your custom
# domain. Uploaded images are served from here, so the bucket needs public read.
R2_PUBLIC_BASE_URL=

# Separate bucket WITHOUT public access, for invoice PDFs and database backups.
# The public URL above exposes every object in R2_BUCKET, so tenant data must not
# live there. Left empty, invoices and backups stay on local disk.
R2_PRIVATE_BUCKET=
